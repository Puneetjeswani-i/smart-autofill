{
  "manifest_version": 3,
  "name": "Smart Autofill — eMitra Assistant",
  "version": "6.0.0",
  "description": "Fills the current customer's details from the Smart Autofill app on this computer into government portal forms — after you preview them.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "https://*.gov.in/*",
    "http://*.gov.in/*",
    "https://*.nic.in/*",
    "http://*.nic.in/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Smart Autofill"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.gov.in/*",
        "http://*.gov.in/*",
        "https://*.nic.in/*",
        "http://*.nic.in/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:3001/*",
        "http://127.0.0.1:3001/*",
        "http://localhost:3000/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
