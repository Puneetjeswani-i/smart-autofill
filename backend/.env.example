# Smart Autofill — backend settings.
# Copy this file to ".env" in the same folder and edit the values.

# Port the app runs on (open http://localhost:3001)
PORT=3001

# 127.0.0.1 = only this computer can open the app (recommended for a shop).
# Use 0.0.0.0 ONLY if you understand that other devices on your Wi-Fi could connect.
HOST=127.0.0.1

NODE_ENV=production

# Optional cloud AI for better extraction (create a key at https://console.groq.com/keys).
# Aadhaar numbers are masked before anything is sent. Leave empty to work fully offline.
GROQ_API_KEY=
# If Groq retires this model, the app picks an available one automatically.
GROQ_MODEL=openai/gpt-oss-120b

# Demo features (fictional demo customer + simulated DigiLocker). Keep false in a real shop.
DEMO_MODE=false

# Real DigiLocker — only for approved APISetu partners. Leave empty otherwise.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:3001/auth/digilocker/callback
