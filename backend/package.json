{
  "name": "smart-autofill-backend",
  "version": "6.0.0",
  "private": true,
  "description": "Smart Autofill v6 — eMitra / CSC shop assistant: document reading, eligibility, autofill, registers",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test \"test/*.test.js\"",
    "ocr:download": "node scripts/download-ocr-data.js",
    "reset-pin": "node scripts/reset-pin.js",
    "import-legacy": "node scripts/import-legacy.js",
    "check": "node -e \"['express','cors','dotenv','multer','pdf-lib','pdf-parse','sharp','tesseract.js'].forEach(m=>{try{require(m);console.log('OK ',m)}catch{console.error('MISSING:',m)}});require('node:sqlite');console.log('OK  node:sqlite')\""
  },
  "dependencies": {
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.33.2",
    "tesseract.js": "^5.0.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}
